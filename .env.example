# Credenciales de la app web de Firebase (Consola → Configuración del proyecto → Tus apps → SDK).
# Copiá este archivo como .env y completá los valores. No son secretos (viajan al navegador),
# pero conviene no subirlos al repo. La seguridad la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
